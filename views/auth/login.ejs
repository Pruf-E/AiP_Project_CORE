<% layout('layout') %>
<section class="auth-layout"><div class="auth-art"><span class="eyebrow">CORE / MEMBER AREA</span><span class="auth-glyph">✳</span><p>Место, где собираются<br>визуальные миры.</p><span class="auth-edition">FIELD GUIDE · 001</span></div><form class="form-card auth-form" action="/login" method="post"><p class="eyebrow">С РАДОСТЬЮ СНОВА</p><h1>Войти <em>в каталог.</em></h1><label>Имя пользователя<input name="username" required autocomplete="username" value="<%= username || '' %>" placeholder="Ваше имя"></label><label>Пароль<input type="password" name="password" required autocomplete="current-password" placeholder="Не менее 8 символов"></label><button class="button button-dark form-submit" type="submit">Войти <span>↗</span></button><p class="form-switch">Впервые здесь? <a href="/register">Создать аккаунт →</a></p></form></section>
