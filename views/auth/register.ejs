<% layout('layout') %>
<section class="auth-layout"><div class="auth-art auth-art-register"><span class="eyebrow">CORE / COMMUNITY</span><span class="auth-glyph">✳</span><p>Твоя точка входа<br>в новый визуальный мир.</p><span class="auth-edition">FIELD GUIDE · 001</span></div><form class="form-card auth-form" action="/register" method="post"><p class="eyebrow">ПРИСОЕДИНЯЙСЯ</p><h1>Создать <em>аккаунт.</em></h1><label>Имя пользователя<input name="username" required minlength="3" maxlength="24" autocomplete="username" value="<%= username || '' %>" placeholder="От 3 до 24 символов"><span class="field-note">Буквы, цифры, дефис и подчёркивание</span></label><label>Пароль<input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="Не менее 8 символов"></label><button class="button button-dark form-submit" type="submit">Создать аккаунт <span>↗</span></button><p class="form-switch">Уже есть аккаунт? <a href="/login">Войти →</a></p></form></section>
