<% layout('layout') %>
<section class="page-intro"><p class="eyebrow"><span class="online-dot"></span> АРХИВ ЭСТЕТИК · <%= styles.length.toString().padStart(2, '0') %> НАПРАВЛЕНИЙ</p><h1>Каталог<br><em>core-миров.</em></h1><p class="lead">Каждое направление — свой визуальный язык. Выбирай, исследуй, добавляй то, чего нам не хватает.</p></section>
<section class="catalog-tools"><form class="search-form" action="/core" method="get"><label class="sr-only" for="q">Поиск по каталогу</label><span>⌕</span><input id="q" type="search" name="q" value="<%= search %>" placeholder="Поиск по эстетикам..."><button type="submit">Найти ↗</button></form><% if (currentUser) { %><a class="button button-dark" href="/core/new">＋ Добавить эстетку</a><% } else { %><a class="button button-outline" href="/login">Предложить направление <span>↗</span></a><% } %></section>
<% if (styles.length) { %><div class="card-grid catalog-grid"><% styles.forEach((style, index) => { %><%- include('../partials/card', { style, index }) %><% }) %></div><% } else { %><div class="empty-note"><span>⌕</span><p><%= search ? 'По запросу ничего не нашлось. Попробуй другое слово.' : 'Каталог пока пуст. Войди, чтобы добавить первое направление.' %></p><a class="text-link" href="/core">Сбросить поиск →</a></div><% } %>
